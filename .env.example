# Copy to .env.local and fill in. None of these is needed to run the site locally.

# Public origin of the site, without a trailing slash.
# Until this is set, robots.txt blocks all crawlers.
NEXT_PUBLIC_SITE_URL=

# The product app. Leave empty before launch: every call to action then leads
# to the interest form. Once set, the same buttons open the free introduction.
NEXT_PUBLIC_APP_URL=

# Contact address shown as a fallback when the form cannot send.
NEXT_PUBLIC_CONTACT_EMAIL=

# Interest form delivery through Amazon SES (app/api/interest).
# The sender's domain must be a verified SES identity in SES_REGION.
INTEREST_MAIL_TO=
INTEREST_MAIL_FROM=
SES_REGION=eu-central-1
